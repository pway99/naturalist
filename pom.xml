    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.0</spring-boot.version>
        <jte.version>3.2.1</jte.version>
        <cdk.version>2.12</cdk.version>
        <archunit.version>1.4.2</archunit.version>
        <aspectj.version>1.9.25</aspectj.version>
        <mybatis-version>3.5.16</mybatis-version>
        <mybatis-spring-boot-starter-version>3.0.4</mybatis-spring-boot-starter-version>
        <postgresql-version>42.7.4</postgresql-version>
        <hikaricp-version>5.1.0</hikaricp-version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>weaver-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>6.45.0</version>
                <configuration>
                    <activeRecipes>
                        <recipe>com.naturalist.EnforceArchitecture</recipe>
                    </activeRecipes>
                    <failOnDryRunResults>true</failOnDryRunResults>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.naturalist</groupId>
                        <artifactId>naturalist-rewrite</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- The sun-misc-unsafe-memory-access=allow flag silences the JEP-498
                             warning aspectjweaver's load-time weaver triggers on JDK 25 (it calls
                             the terminally-deprecated sun.misc.Unsafe::objectFieldOffset). Harmless;
                             drop the flag once AspectJ stops using Unsafe. -->
                        <argLine>-javaagent:${org.aspectj:aspectjweaver:jar} --sun-misc-unsafe-memory-access=allow</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

