        <!-- KERNELS -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>image-store-filesystem</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>observation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>vision</artifactId>
        </dependency>

        <!-- ADAPTERS -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>anthropic-vision</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>eol-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>mail-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>challenge-turnstile</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>resilience-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>spring-runtime</artifactId>
        </dependency>
        <!-- COMPILE SCOPE ON PURPOSE — do not "clean this up" to test scope.
             Ships the NaturalistDatabase bean, which production needs today: EolClientMock
             (kernels/authority, awaiting Phase 4's real client) is a @DomainService on the
             production classpath and constructor-injects it. Test-scoping this packages a jar
             that dies on boot with "required a bean of type NaturalistDatabase".
             It also ships MockDomainServiceScan, which is harmless here: the scan finds
             @MockDomainService classes only if a *-repository-test jar is present, and those are
             test-scoped below. Presence of the mocks — not this jar — is what decides whether a
             context runs on doubles. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>spring-test-data</artifactId>
        </dependency>
        <!-- COMPILE SCOPE ON PURPOSE — do not "clean this up" to test scope.
             framework-test looks like test infra leaking into the deployable, and the reactor
             pom's scope-less managed entry does force it to compile even as a transitive of a
             test-scoped dependency. But the app genuinely needs it at runtime: EolClientMock
             (kernels/authority) is a @DomainService on the production classpath and extends
             TestEntitySource, so DomainServiceScan instantiates it at startup. Marking this
             test-scoped packages a jar that dies with NoClassDefFoundError:
             com/naturalist/data/TestEntitySource on boot.
             This resolves itself with Phase 4 of the external-authority seam — a real EOL client
             replacing the mock — not with scope surgery here.
             ByteBuddy is excluded: only the test object graph uses it, to build its traced subclasses, and
             main code never builds a graph. Tests do, through the test-scoped domain test-contexts below,
             and get ByteBuddy from the test-scoped dependency there. PackagedJarIT checks that it stays out
             of the jar. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>framework-test</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>net.bytebuddy</groupId>
                    <artifactId>byte-buddy</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- DOMAIN CONSOLE MODULES -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>chemistry-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>chemistry-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>garden-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>garden-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>insects-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>insects-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>library-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>library-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>plants-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>plants-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>soil-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>soil-repository-rdbms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-console</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-repository-rdbms</artifactId>
        </dependency>

        <!-- NATURALISTS -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>naturalists-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>naturalists-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>naturalists-repository-rdbms</artifactId>
        </dependency>

        <!-- ACCOUNTS -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>accounts-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>accounts-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>accounts-repository-rdbms</artifactId>
        </dependency>

        <!-- Spring/MyBatis bridge: autoconfigures the DataSource + SqlSessionFactory
             from application.yml so the scanned rdbms @DomainService adapters resolve
             their package-private mappers (registered via @MapperScan). -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- TEST -->

        <!-- In-memory @MockDomainService doubles. Test scope only: they replace the rdbms
             adapters under the `mock-data` profile so app-level tests never touch the standing
             naturalist_test Postgres (see MockDataConfiguration). -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>accounts-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>chemistry-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>garden-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>insects-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>library-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>naturalists-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>plants-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>soil-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-repository-test</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

        <!-- Domain test-contexts: real, graph-built domain services over a test's own database, for the
             plain unit tests here that need one (no Spring context). The graph builds its traced
             subclasses with ByteBuddy, excluded from framework-test above for the jar's sake, so it is
             declared again at test scope, where it never reaches the jar. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-test-context</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- No Mockito, for the reason spring-console-test's POM gives. -->
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <useSystemClassLoader>true</useSystemClassLoader>
                    <!-- The classpath governs which persistence an app-level test sees.
                         Maven has no scope meaning "runtime but not test" — every scope that
                         reaches runtime also reaches test — so the rdbms adapters would
                         otherwise sit on the test classpath and DomainServiceScan would find
                         them. Dropping the jars here is what makes their absence a fact rather
                         than a flag: no profile to forget, no property to mis-set. The mock
                         half arrives the same way, as the test-scoped spring-test-data jar.
                         Guarded by MockPersistenceWiringTest. -->
                    <classpathDependencyExcludes>
                        <exclude>com.naturalist:accounts-repository-rdbms</exclude>
                        <exclude>com.naturalist:chemistry-repository-rdbms</exclude>
                        <exclude>com.naturalist:garden-repository-rdbms</exclude>
                        <exclude>com.naturalist:insects-repository-rdbms</exclude>
                        <exclude>com.naturalist:library-repository-rdbms</exclude>
                        <exclude>com.naturalist:naturalists-repository-rdbms</exclude>
                        <exclude>com.naturalist:plants-repository-rdbms</exclude>
                        <exclude>com.naturalist:soil-repository-rdbms</exclude>
                        <exclude>com.naturalist:usage-repository-rdbms</exclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <!-- Templates live in eight modules and compile together, because the domain consoles
                 share the app's layout. A jar cannot compile them at runtime (no plain classpath, no
                 sources), so the build gathers them, compiles them and puts the classes in the jar.
                 A template that does not compile now fails the build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>gather-templates</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jte-sources</outputDirectory>
                            <resources>
                                <resource><directory>${project.basedir}/../../apps/management-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/chemistry/chemistry-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/garden/garden-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/insects/insects-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/library/library-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/plants/plants-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/soil/soil-console/src/main/jte</directory></resource>
                                <resource><directory>${project.basedir}/../../domains/usage/usage-console/src/main/jte</directory></resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-compiled-templates</id>
                        <phase>process-classes</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/jte-compiled</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>gg.jte</groupId>
                <artifactId>jte-maven-plugin</artifactId>
                <version>${jte.version}</version>
                <configuration>
                    <sourceDirectory>${project.build.directory}/jte-sources</sourceDirectory>
                    <targetDirectory>${project.build.directory}/jte-compiled</targetDirectory>
                    <contentType>Html</contentType>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals><goal>precompile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <packagedJar>${project.build.directory}/${project.build.finalName}.jar</packagedJar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.naturalist.console.ConsoleApplication</mainClass>
                    <!-- spring-boot:run only: templates recompile from source as they are edited.
                         A packaged jar always uses the compiled classes. -->
                    <systemPropertyVariables>
                        <gg.jte.development-mode>true</gg.jte.development-mode>
                    </systemPropertyVariables>
                </configuration>
                <!-- Bind `repackage` explicitly. It is NOT implicit here: the goal is bound to
                     the package phase by spring-boot-starter-parent's pluginManagement, and this
                     reactor's parent is `naturalist`, not that. Without this execution `mvn
                     package` produced a plain jar with no BOOT-INF/ and no launcher — importable
                     as a library, not runnable with `java -jar`. `spring-boot:run` never noticed,
                     which is why the gap survived: it builds a classpath from the reactor rather
                     than from the artifact. -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
