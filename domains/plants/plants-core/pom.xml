<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.naturalist</groupId>
        <artifactId>plants</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>plants-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>plants-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>framework</artifactId>
        </dependency>
        <!-- PlantsEntityRefResolver implements library's EntityRefResolver port, so plant taxa
             can be citation subjects. DAG rule 2: a core may import another domain's api. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>library-api</artifactId>
        </dependency>

        <!-- TEST DEPENDENCIES -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>catalog-inmem</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>plants-repository-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Ships plants' test contexts (the *TestContextInternal classes and their services entry) to
                 plants-test-context in the test-jar, and nothing else: the test classes stay private here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*TestContextInternal*</include>
                                <include>META-INF/services/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
