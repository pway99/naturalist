<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.naturalist</groupId>
        <artifactId>usage</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>usage-console</artifactId>
    <name>usage :: console</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- TEST: the shared console-slice toolchain (JTE engine + view resolver +
             spring-boot-starter-test + spring-webmvc + framework-test, transitively).
             No spring-security: the /admin/usage route is secured app-side. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>spring-console-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TEST: wired in-memory UsageQuery/UsageCommand/IdentificationBudget over a
             shared database, so the slice can reserve budget and read it back. -->
        <dependency>
            <groupId>com.naturalist</groupId>
            <artifactId>usage-test-context</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
